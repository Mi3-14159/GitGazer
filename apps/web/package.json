{
  "dependencies": {
    "@tailwindcss/vite": "catalog:",
    "class-variance-authority": "catalog:",
    "clsx": "catalog:",
    "date-fns": "catalog:",
    "echarts": "catalog:",
    "lucide-vue-next": "catalog:",
    "pinia": "catalog:",
    "radix-vue": "catalog:",
    "tailwind-merge": "catalog:",
    "tailwindcss": "catalog:",
    "vue": "catalog:",
    "vue-echarts": "catalog:",
    "vue-router": "catalog:"
  },
  "devDependencies": {
    "@vitejs/plugin-basic-ssl": "catalog:",
    "@vitejs/plugin-vue": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "@vue/test-utils": "catalog:",
    "happy-dom": "catalog:",
    "unplugin-vue-components": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:",
    "vue-tsc": "catalog:"
  },
  "engineStrict": true,
  "engines": {
    "node": "^24"
  },
  "name": "@gitgazer/web",
  "nx": {
    "implicitDependencies": [
      "@gitgazer/db"
    ],
    "targets": {
      "upload": {
        "executor": "nx:run-commands",
        "options": {
          "cwd": "{projectRoot}",
          "parallel": false,
          "commands": [
            "aws s3 sync dist/ \"s3://${FRONTEND_S3_BUCKET_NAME:?required}/\" --cache-control max-age=604800 --exclude '*.html'",
            "aws s3 sync dist/ \"s3://${FRONTEND_S3_BUCKET_NAME:?required}/\" --cache-control max-age=60 --exclude '*' --include '*.html'"
          ]
        }
      }
    }
  },
  "scripts": {
    "build": "vue-tsc --noEmit && nx vite:build",
    "dev": "nx serve",
    "dev:local": "nx serve",
    "dev:prod": "nx serve --mode production",
    "lint": "eslint src --ext .ts",
    "lint:fix": "eslint src --ext .ts --fix",
    "pretty": "prettier --write src",
    "pretty:check": "prettier --check src",
    "test": "nx vitest:test",
    "test:run": "nx vitest:test --run"
  },
  "type": "module",
  "version": "0.0.0"
}
