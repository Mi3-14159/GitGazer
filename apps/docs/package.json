{
  "browserslist": {
    "development": [
      "last 3 chrome version",
      "last 3 firefox version",
      "last 5 safari version"
    ],
    "production": [
      ">0.5%",
      "not dead",
      "not op_mini all"
    ]
  },
  "dependencies": {
    "@docusaurus/core": "catalog:",
    "@docusaurus/faster": "catalog:",
    "@docusaurus/preset-classic": "catalog:",
    "@docusaurus/theme-mermaid": "catalog:",
    "@easyops-cn/docusaurus-search-local": "catalog:",
    "@mdx-js/react": "catalog:",
    "clsx": "catalog:",
    "prism-react-renderer": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:"
  },
  "devDependencies": {
    "@docusaurus/module-type-aliases": "catalog:",
    "@docusaurus/tsconfig": "catalog:",
    "@docusaurus/types": "catalog:",
    "@types/react": "catalog:",
    "typescript": "catalog:"
  },
  "engines": {
    "node": "^24"
  },
  "name": "@gitgazer/docs",
  "nx": {
    "targets": {
      "upload": {
        "executor": "nx:run-commands",
        "options": {
          "cwd": "{projectRoot}",
          "parallel": false,
          "commands": [
            "aws s3 sync dist/ \"s3://${DOCS_S3_BUCKET:?required}/\" --delete --cache-control 'public, max-age=31536000, immutable' --exclude '*.html' --exclude 'sitemap.xml' --exclude 'robots.txt'",
            "aws s3 sync dist/ \"s3://${DOCS_S3_BUCKET:?required}/\" --delete --cache-control 'public, max-age=0, must-revalidate' --exclude '*' --include '*.html' --include 'sitemap.xml' --include 'robots.txt'",
            "aws cloudfront create-invalidation --paths '/*' --distribution-id \"$(aws cloudfront list-distributions --query \"DistributionList.Items[?Aliases.Items[?contains(@, '${DOCS_DOMAIN:-docs.gitgazer.com}')]].Id | [0]\" --output text)\""
          ]
        }
      }
    }
  },
  "private": true,
  "scripts": {
    "build": "docusaurus build --out-dir dist",
    "clear": "docusaurus clear && rm -rf dist",
    "docusaurus": "docusaurus",
    "serve": "docusaurus serve --dir dist",
    "start": "docusaurus start",
    "swizzle": "docusaurus swizzle",
    "typecheck": "tsc",
    "write-heading-ids": "docusaurus write-heading-ids",
    "write-translations": "docusaurus write-translations"
  },
  "version": "0.0.0"
}
