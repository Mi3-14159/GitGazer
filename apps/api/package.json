{
  "author": "",
  "bugs": {
    "url": "https://github.com/Mi3-14159/GitGazer/issues"
  },
  "dependencies": {
    "convict": "catalog:"
  },
  "description": "lambda as API",
  "devDependencies": {
    "@aws-lambda-powertools/event-handler": "catalog:",
    "@aws-lambda-powertools/jmespath": "catalog:",
    "@aws-lambda-powertools/logger": "catalog:",
    "@aws-lambda-powertools/metrics": "catalog:",
    "@aws-sdk/client-apigatewaymanagementapi": "catalog:",
    "@aws-sdk/client-bedrock-runtime": "catalog:",
    "@aws-sdk/client-lambda": "catalog:",
    "@aws-sdk/client-s3": "catalog:",
    "@aws-sdk/client-secrets-manager": "catalog:",
    "@aws-sdk/client-sesv2": "catalog:",
    "@aws-sdk/client-sqs": "catalog:",
    "@aws-sdk/rds-signer": "catalog:",
    "@aws-sdk/s3-request-presigner": "catalog:",
    "@octokit/auth-app": "catalog:",
    "@octokit/rest": "catalog:",
    "@octokit/webhooks": "catalog:",
    "@octokit/webhooks-schemas": "catalog:",
    "@octokit/webhooks-types": "catalog:",
    "@types/aws-lambda": "catalog:",
    "@types/convict": "catalog:",
    "@types/pg": "catalog:",
    "ajv": "catalog:",
    "ajv-formats": "catalog:",
    "aws-jwt-verify": "catalog:",
    "drizzle-kit": "catalog:",
    "drizzle-orm": "catalog:",
    "pg": "catalog:",
    "ts-node": "catalog:",
    "tsconfig-paths": "catalog:",
    "tsup": "catalog:",
    "vite": "catalog:"
  },
  "engines": {
    "node": "^24"
  },
  "homepage": "https://github.com/Mi3-14159/GitGazer#readme",
  "keywords": [],
  "name": "@gitgazer/lambdas",
  "nx": {
    "implicitDependencies": [
      "@gitgazer/db"
    ],
    "targets": {
      "buildZip": {
        "cache": true,
        "inputs": [
          "production",
          "^production"
        ],
        "outputs": [
          "{projectRoot}/dist",
          "{projectRoot}/tmp"
        ]
      }
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Mi3-14159/GitGazer.git"
  },
  "scripts": {
    "build": "pnpm run clean && tsup",
    "buildZip": "pnpm run build && pnpm run zip -- api && pnpm run zip -- websocket && pnpm run zip -- worker && pnpm run zip -- org-sync-scheduler && pnpm run zip -- backfill-worker && pnpm run zip -- http-proxy",
    "clean": "rimraf dist tmp",
    "db:migrate:manual": "node --env-file=.env -r ts-node/register src/scripts/run-drizzle-migrations.ts",
    "dev:api": "node --env-file=.env --watch -r ts-node/register src/develop.ts",
    "dev:backfill": "node --env-file=.env -r ts-node/register src/scripts/run-backfill-task.ts",
    "dev:worker": "node --env-file=.env -r ts-node/register src/scripts/run-worker-task.ts",
    "lint": "eslint src --ext .ts",
    "lint:fix": "eslint src --ext .ts --fix",
    "pretty": "prettier --write src",
    "pretty:check": "prettier --check src",
    "test:unit": "nx vitest:test -- --project unit --run",
    "typecheck": "tsc --noEmit -p tsconfig.json --rootDir ../.. --ignoreDeprecations 6.0",
    "zip": "f() { [ \"$1\" = \"--\" ] && shift; cd dist/$1 && zip gitgazer-$1.zip -qr * && mkdir -p ../../tmp && mv gitgazer-$1.zip ../../tmp/; }; f"
  },
  "version": "1.0.0"
}
